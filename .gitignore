/docs/paper/ai_driven_rf_design_arxiv.pdf
/docs/paper/ai_driven_rf_design_ieee_access.pdf
/docs/paper/submission/access.tex
/docs/paper/submission/*.tar.gz
/measurements/*/processed/

# Stray photos in the project root are never committed (only docs/ ones are).
/*.png
/*.jpeg
/*.jpg
