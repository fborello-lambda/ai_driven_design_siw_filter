# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# All script outputs go here (regenerable); committed figures live in docs/.
# Exception: keep the EM calibration cache (expensive to regenerate, hours of
# openEMS) so a fresh clone still gets the calibrated iris widths.
/output/*
!/output/data
/output/data/*
!/output/data/calibration.json

# Stray photos in the project root are never committed (only docs/ ones are).
/*.png
/*.jpeg
/*.jpg
